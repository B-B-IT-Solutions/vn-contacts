				 <column name="last_name" type="VARCHAR(255)"/>
				 <column name="nick_name" type="VARCHAR(255)"/>
				 <column name="email" type="VARCHAR(255)"/>
				 <column name="job_title" type="VARCHAR(500)"/>
				 <column name="company" type="VARCHAR(500)"/>
				 <column name="industry" type="VARCHAR(500)"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
				 <column name="date_of_birth" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
			</createTable>
			
			<createTable tableName="contact_telephone">
