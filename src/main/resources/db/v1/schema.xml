<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
									 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
									 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
	 
	 <changeSet author="sergej" id="1.0.1">
			<createSequence cacheSize="1" cycle="false" startValue="1" minValue="1" maxValue="9223372036854775807"
											sequenceName="hiberante_sequence"/>
			
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="contact_seq"/>
			
			<createTable tableName="contact">
				 <column name="contact_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="contact_pk" nullable="false"/>
				 </column>
				 <column name="first_name" type="VARCHAR(255)"/>
				 <column name="middle_name" type="VARCHAR(255)"/>
				 <column name="last_name" type="VARCHAR(255)"/>
				 <column name="nick_name" type="VARCHAR(255)"/>
				 <column name="email" type="VARCHAR(255)"/>
				 <column name="job_title" type="VARCHAR(500)"/>
				 <column name="company" type="VARCHAR(500)"/>
				 <column name="industry" type="VARCHAR(500)"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
				 <column name="date_of_birth" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
			</createTable>
			
			<createTable tableName="contact_telephone">
				 <column name="contact_id" type="BIGINT"/>
				 <column name="value" type="VARCHAR(100)"/>
				 <column name="type" type="VARCHAR(100)"/>
			</createTable>
			
			<createTable tableName="contact_email">
				 <column name="contact_id" type="BIGINT"/>
				 <column name="value" type="VARCHAR(100)"/>
				 <column name="type" type="VARCHAR(100)"/>
			</createTable>
			
			<createTable tableName="contact_url">
				 <column name="contact_id" type="BIGINT"/>
				 <column name="value" type="VARCHAR(100)"/>
				 <column name="type" type="VARCHAR(100)"/>
			</createTable>
			
			<createTable tableName="contact_label">
				 <column name="contact_id" type="BIGINT"/>
				 <column name="LABEL" type="VARCHAR(250)"/>
			</createTable>
			
			<createTable tableName="about">
				 <column name="contact_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="about_pk" nullable="false"/>
				 </column>
				 <column name="description" type="TEXT"/>
				 <column name="FIRST_MEETING_OCCURRENCE_DATE" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="FIRST_MEETING_LOCATION" type="VARCHAR(500)"/>
				 <column name="FIRST_MEETING_COMMENT" type="TEXT"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
			</createTable>
			
			<addForeignKeyConstraint baseTableName="about" baseColumnNames="contact_id" constraintName="about_contact_id_fkey"
															 deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" referencedTableName="contact"
															 referencedColumnNames="contact_id" validate="true"/>
	 </changeSet>
	 
	 <changeSet author="sergej" id="1.0.2">
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="note_seq"/>
			
			<createTable tableName="note">
				 <column name="note_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="note_pk" nullable="false"/>
				 </column>
				 <column name="contact_id" type="BIGINT"/>
				 <column name="title" type="VARCHAR(1000)"/>
				 <column name="text" type="TEXT"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
			</createTable>
			
			<addForeignKeyConstraint baseTableName="note" baseColumnNames="contact_id" constraintName="note_contact_id_fkey"
															 deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" referencedTableName="contact"
															 referencedColumnNames="contact_id" validate="true"/>
	 </changeSet>
	 
	 <changeSet author="sergej" id="1.0.3">
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="settings_seq"/>
			
			<createTable tableName="account_settings">
				 <column name="settings_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="general_settings_pk" nullable="false"/>
				 </column>
				 <column name="app_language" type="VARCHAR(255)"/>
			</createTable>
			
			<createTable tableName="user_settings">
				 <column name="settings_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="user_settings_pk" nullable="false"/>
				 </column>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
			</createTable>
			
			<createTable tableName="contact_settings_label">
				 <column name="settings_id" type="BIGINT"/>
				 <column name="value" type="VARCHAR(250)"/>
				 <column name="color" type="VARCHAR(50)"/>
			</createTable>
			
			<createTable tableName="contact_settings_industry">
				 <column name="settings_id" type="BIGINT"/>
				 <column name="name" type="VARCHAR(250)"/>
			</createTable>
	 </changeSet>
	 
	 <changeSet author="sergej" id="1.0.4">
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="task_seq"/>
			
			<createTable tableName="task">
				 <column name="task_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="task_pk" nullable="false"/>
				 </column>
				 <column name="contact_id" type="BIGINT"/>
				 <column name="title" type="VARCHAR(1000)"/>
				 <column name="description" type="TEXT"/>
				 <column name="completed" type="BOOLEAN"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
			</createTable>
			
			<addForeignKeyConstraint baseTableName="task" baseColumnNames="contact_id" constraintName="task_contact_id_fkey"
															 deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" referencedTableName="contact"
															 referencedColumnNames="contact_id" validate="true"/>
	 </changeSet>
	 
	 <changeSet author="sergej" id="1.0.5">
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="reminder_seq"/>
			
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="recurrence_seq"/>
			
			<createTable tableName="reminder">
				 <column name="reminder_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="reminder_pk" nullable="false"/>
				 </column>
				 <column name="contact_id" type="BIGINT"/>
				 <column name="title" type="VARCHAR(1000)"/>
				 <column name="description" type="TEXT"/>
				 <column name="recurrence_id" type="BIGINT"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
			</createTable>
			
			<createTable tableName="recurrence">
				 <column name="recurrence_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="recurrence_pk" nullable="false"/>
				 </column>
				 <column name="value" type="VARCHAR(500)"/>
				 <column name="next_occurrence" type="TIMESTAMP WITH TIME ZONE"/>
			</createTable>
			
			<addForeignKeyConstraint baseTableName="reminder" baseColumnNames="contact_id" constraintName="reminder_contact_id_fkey"
															 deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" referencedTableName="contact"
															 referencedColumnNames="contact_id" validate="true"/>
			
			
			<addForeignKeyConstraint baseTableName="reminder" baseColumnNames="recurrence_id"
															 constraintName="reminder_recurrence_id_fkey"
															 deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" referencedTableName="recurrence"
															 referencedColumnNames="recurrence_id" validate="true"/>
	 
	 
	 </changeSet>
	 
	 <changeSet author="sergej" id="1.0.6">
			<createTable tableName="contact_industry">
				 <column name="contact_id" type="BIGINT"/>
				 <column name="industry" type="VARCHAR(250)"/>
			</createTable>
	 </changeSet>
	 
	 <changeSet author="sergej" id="1.0.7">
			<renameColumn tableName="contact_settings_industry" newColumnName="value" oldColumnName="name"
										columnDataType="VARCHAR(250)"/>
			
			<addColumn tableName="contact_settings_industry">
				 <column name="color" type="varchar(255)"/>
			</addColumn>
	 </changeSet>
</databaseChangeLog>