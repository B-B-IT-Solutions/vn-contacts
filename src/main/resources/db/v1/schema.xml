<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
									 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
									 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
	 
	 <changeSet author="sergej" id="1.0.1">
			<createSequence cacheSize="1" cycle="false" startValue="1" minValue="1" maxValue="9223372036854775807"
											sequenceName="hiberante_sequence"/>
			
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="contact_seq"/>
			
			<createTable tableName="contact">
				 <column name="contact_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="contact_pk" nullable="false"/>
				 </column>
				 <column name="first_name" type="VARCHAR(255)"/>
				 <column name="middle_name" type="VARCHAR(255)"/>
				 <column name="last_name" type="VARCHAR(255)"/>
				 <column name="nick_name" type="VARCHAR(255)"/>
				 <column name="email" type="VARCHAR(255)"/>
				 <column name="professions" type="VARCHAR(1000)"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
			</createTable>
	 </changeSet>
	 
	 <changeSet author="sergej" id="1.0.2">
			<createSequence cacheSize="1" cycle="false" startValue="1000" minValue="1000" maxValue="9223372036854775807"
											sequenceName="note_seq"/>
			
			<createTable tableName="note">
				 <column name="note_id" type="BIGINT">
						<constraints primaryKey="true" primaryKeyName="note_pk" nullable="false"/>
				 </column>
				 <column name="contact_id" type="BIGINT"/>
				 <column name="text" type="TEXT"/>
				 <column name="last_edit_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
				 <column name="owner_username" type="VARCHAR(255)"/>
				 <column name="owner_email" type="VARCHAR(255)"/>
			</createTable>
			
			<addForeignKeyConstraint baseTableName="note" baseColumnNames="contact_id" constraintName="contact_id_fkey"
															 deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" referencedTableName="contact"
															 referencedColumnNames="contact_id" validate="true"/>
	 </changeSet>
</databaseChangeLog>